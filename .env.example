# Copy to .env alongside compose.prod.yaml and fill in.

# Public URL of the web interface, used to build absolute links.
APP_BASE_URL=https://mail.example.com

# Generate with: openssl rand -hex 32
# Changing this makes every stored upstream credential unreadable.
ENCRYPTION_MASTER_KEY=

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Pin a release rather than tracking latest.
IMAPPED_VERSION=latest
